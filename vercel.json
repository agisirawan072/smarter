{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/smarter-data",
      "destination": "/api/smarter-data.js"
    },
    {
      "source": "/api/add-stars",
      "destination": "/api/add-stars.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

